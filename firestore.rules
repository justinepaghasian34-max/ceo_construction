rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own document; admins/CEO head can read all
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isCeoHead() ||
        isMaterials() ||
        isPayroll()
      );

      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.otpVerified == false &&
        request.resource.data.isActive == true &&
        request.resource.data.assignedProjects is list &&
        request.resource.data.assignedProjects.size() == 0 &&
        (
          request.resource.data.role in ['admin', 'site_manager', 'payroll', 'materials']
        );

      allow update: if request.auth != null && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isActive == resource.data.isActive &&
          request.resource.data.otpVerified == resource.data.otpVerified &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'phoneNumber',
            'department',
            'profileImageUrl',
            'updatedAt'
          ])
        ) ||
        (
          (isAdmin() || isCeoHead()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'assignedProjects',
            'otpVerified',
            'otpVerifiedAt',
            'updatedAt',
            'isActive'
          ])
        )
      );

      allow delete: if false;
    }

    match /email_otps/{otpId} {
      allow read, write: if false;
    }

    match /auth_rate_limits/{limitId} {
      allow read, write: if false;
    }
    
    // Projects collection - role-based access
    match /projects/{projectId} {
      // Admin can read all, CEO Head can read all, Site Managers can read
      // projects they are assigned to via hasProjectAccess(projectId).
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isMaterials() ||
        isPayroll() ||
        (isSiteManager() && (
          hasProjectAccess(projectId) ||
          resource.data.siteManagerId == request.auth.uid ||
          (
            resource.data.projectEngineerEmail is string &&
            request.auth.token.email is string &&
            resource.data.projectEngineerEmail.lower() == request.auth.token.email.lower()
          )
        ))
      );

      // Admin can create/update/delete projects. CEO Head can create projects.
      allow create: if request.auth != null && (isAdmin() || isCeoHead());
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          isSiteManager() &&
          (hasProjectAccess(projectId) || isProjectSiteManager(projectId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'progressPercentage',
            'progress',
            'updatedAt'
          ])
        )
      );
      allow delete: if request.auth != null && isAdmin();

      match /material_inventory/{itemId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          isCeoHead() ||
          isMaterials() ||
          (isSiteManager() && hasProjectAccess(projectId))
        );

        allow create, delete: if request.auth != null && (isAdmin() || isMaterials());

        // Admin can update freely. Site managers can only decrement stock for
        // assigned projects (best-effort inventory deduction after usage sync).
        allow update: if request.auth != null && (
          isAdmin() ||
          isMaterials() ||
          (
            isSiteManager() &&
            hasProjectAccess(projectId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'stock',
              'updatedAt'
            ]) &&
            request.resource.data.stock is number &&
            resource.data.stock is number &&
            request.resource.data.stock <= resource.data.stock &&
            request.resource.data.stock >= 0
          )
        );
      }

      match /material_allocations/{allocationId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          isCeoHead() ||
          isMaterials() ||
          (isSiteManager() && (hasProjectAccess(projectId) || isProjectSiteManager(projectId)))
        );

        allow write: if request.auth != null && (isAdmin() || isMaterials());
      }
      
      // Daily reports sub-collection
      match /daily_reports/{reportId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          isCeoHead() ||
          isMaterials() ||
          isPayroll() ||
          hasProjectAccess(projectId)
        );
        allow create: if request.auth != null && (
          isSiteManager() && hasProjectAccess(projectId)
        );
        allow update: if request.auth != null && (
          isAdmin() || 
          (isSiteManager() && hasProjectAccess(projectId) && resource.data.reporterId == request.auth.uid)
        );
        
        // Material usage sub-collection
        match /material_usage/{usageId} {
          allow read, write: if request.auth != null && (
            isAdmin() ||
            isMaterials() ||
            (isSiteManager() && hasProjectAccess(projectId))
          );
        }
      }
      
      // Attendance sub-collection
      match /attendance/{attendanceId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          isCeoHead() ||
          isPayroll() ||
          hasProjectAccess(projectId)
        );
        allow write: if request.auth != null && (
          isSiteManager() && hasProjectAccess(projectId)
        );
      }

      // GovTrack AI reports sub-collection
      match /govtrack_reports/{reportId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          isCeoHead() ||
          hasProjectAccess(projectId)
        );
        allow create: if request.auth != null && (
          isAdmin() ||
          (isSiteManager() && hasProjectAccess(projectId))
        );
        allow update, delete: if request.auth != null && isAdmin();
      }
      
      // Payroll sub-collection
      match /payroll/{payrollId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          isCeoHead() ||
          isPayroll() ||
          (isSiteManager() && hasProjectAccess(projectId))
        );
        allow create: if request.auth != null && (isAdmin() || isPayroll());
        allow update: if request.auth != null && (isAdmin() || isPayroll());
        
        // Payroll items sub-collection
        match /items/{itemId} {
          allow read, write: if request.auth != null && (isAdmin() || isPayroll());
        }
      }
      
      // Deliveries sub-collection
      match /deliveries/{deliveryId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          isCeoHead() ||
          isMaterials() ||
          hasProjectAccess(projectId) ||
          isProjectSiteManager(projectId)
        );
        allow write: if request.auth != null && (
          isAdmin() ||
          isMaterials() ||
          (isSiteManager() && (hasProjectAccess(projectId) || isProjectSiteManager(projectId)))
        );
      }

      match /material_requests/{requestId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          isCeoHead() ||
          isMaterials() ||
          (isSiteManager() && (hasProjectAccess(projectId) || isProjectSiteManager(projectId)))
        );
        allow create: if request.auth != null && (
          isSiteManager() && (hasProjectAccess(projectId) || isProjectSiteManager(projectId))
        );
        allow update: if request.auth != null && (
          isAdmin() ||
          isMaterials() ||
          (
            isSiteManager() &&
            (hasProjectAccess(projectId) || isProjectSiteManager(projectId)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deliveryStatus',
              'deliveredAt',
              'deliveredBy',
              'deliveredByName'
            ])
          )
        );
      }
      
      // History sub-collection
      match /history/{historyId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          isCeoHead() || 
          hasProjectAccess(projectId)
        );
        allow create: if request.auth != null;
      }

      // Project documents for GovTrack AI (schedules, BOQ, blueprints, SSMP, etc.)
      match /documents/{documentId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          isCeoHead() ||
          (isSiteManager() && (hasProjectAccess(projectId) || isProjectSiteManager(projectId)))
        );
        allow create, update, delete: if request.auth != null && isAdmin();
      }
    }
    
    // Live site weather snapshots used by the admin map
    match /site_weather_snapshots/{snapshotId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isSiteManager() ||
        isMaterials()
      );
      allow create, update: if request.auth != null && (
        isAdmin() ||
        isSiteManager()
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        resource.data.userId == request.auth.uid ||
        (isSiteManager() &&
          resource.data.projectId is string &&
          resource.data.projectId != '' &&
          (hasProjectAccess(resource.data.projectId) ||
            isProjectSiteManager(resource.data.projectId)))
      );

      allow create: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isSiteManager() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.audienceRole == 'admin' ||
        request.resource.data.targetRole == 'admin'
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        (resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid)
      );

      allow delete: if request.auth != null && (isAdmin() || isCeoHead());
    }
    
    // AI Analysis collection (GovTrack chat + progress reports)
    match /ai_analysis/{analysisId} {
      allow read: if request.auth != null && (
        resource.data.submittedByUid == request.auth.uid ||
        isAdmin() ||
        isCeoHead() ||
        (isSiteManager() && canWorkProject(resource.data.projectId))
      );
      allow create: if request.auth != null &&
        request.resource.data.submittedByUid == request.auth.uid &&
        (
          isAdmin() ||
          isCeoHead() ||
          (
            isSiteManager() &&
            (
              !('projectId' in request.resource.data) ||
              request.resource.data.projectId == null ||
              request.resource.data.projectId == '' ||
              canWorkProject(request.resource.data.projectId)
            )
          )
        );
      allow update, delete: if false;
    }
    
    // Audit logs - ADMIN ONLY (Cloud Functions write entries)
    match /audit_logs/{logId} {
      allow read: if request.auth != null && (isAdmin() || isCeoHead());
      allow write: if false;
    }
    
    // Disbursements collection
    match /disbursements/{disbursementId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        isCeoHead()
      );
      allow write: if request.auth != null && isAdmin();
    }

    // Material templates (admin-managed, reusable for projects)
    match /material_templates/{templateId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isMaterials()
      );

      allow create, update, delete: if request.auth != null && (isAdmin() || isMaterials());
    }

    // Collection group rules for history (Project History screen)
    match /{path=**}/history/{historyId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead()
      );
    }

    match /{path=**}/material_requests/{requestId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isMaterials() ||
        (isSiteManager() && hasProjectAccess(resource.data.projectId))
      );

      allow create: if request.auth != null && (
        isAdmin() ||
        isMaterials() ||
        (isSiteManager() && hasProjectAccess(request.resource.data.projectId))
      );

      allow update: if request.auth != null && (isAdmin() || isMaterials());
    }

    // Collection group rules for material usage (Admin Material Monitoring screen)
    match /{path=**}/material_usage/{usageId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isMaterials() ||
        (isSiteManager() && hasProjectAccess(resource.data.projectId))
      );

      allow create, update: if request.auth != null && (
        isAdmin() ||
        isMaterials() ||
        (isSiteManager() && hasProjectAccess(request.resource.data.projectId))
      );

      allow delete: if request.auth != null && isAdmin();
    }

    // Collection group rules for deliveries (Material Monitoring screen)
    match /{path=**}/deliveries/{deliveryId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isMaterials() ||
        (isSiteManager() && hasProjectAccess(resource.data.projectId))
      );
    }

    // Collection group rules for attendance (Admin Payroll monitoring)
    match /{path=**}/attendance/{attendanceId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isPayroll() ||
        (isSiteManager() && hasProjectAccess(resource.data.projectId))
      );
    }

    // Collection group rules for payroll (Admin Payroll monitoring)
    match /{path=**}/payroll/{payrollId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead() ||
        isPayroll() ||
        (isSiteManager() && hasProjectAccess(resource.data.projectId))
      );

      allow create, update, delete: if request.auth != null && (isAdmin() || isPayroll());
    }

    // Collection group rules for payroll items (if queried)
    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null && (isAdmin() || isCeoHead() || isPayroll());
      allow write: if request.auth != null && (isAdmin() || isPayroll());
    }
    
    // Helper functions
    function isAdmin() {
      return getUserRole() in ['admin', 'Admin', 'ADMIN'];
    }
    
    function isSiteManager() {
      return getUserRole() in ['site_manager', 'Site_Manager', 'Site manager', 'site manager', 'SITE_MANAGER'];
    }
    
    function isCeoHead() {
      return getUserRole() in ['ceo_head', 'Ceo_Head', 'CEO_HEAD', 'CEO head', 'ceo head'];
    }

    function isMaterials() {
      return getUserRole() in ['materials', 'Materials', 'MATERIALS', 'material_monitoring'];
    }

    function isPayroll() {
      return getUserRole() in ['payroll', 'Payroll', 'PAYROLL', 'payroll_monitoring'];
    }
    
    function getUserRole() {
      let docRole = exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : '';
      return docRole is string && docRole != ''
          ? docRole
          : (request.auth.token.role is string ? request.auth.token.role : '');
    }
    
    function hasProjectAccess(projectId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedProjects is list &&
          projectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedProjects;
    }

    function isProjectSiteManager(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.siteManagerId == request.auth.uid;
    }

    function emailMatchesProjectEngineer(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.projectEngineerEmail is string &&
          request.auth.token.email is string &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.projectEngineerEmail.lower()
            == request.auth.token.email.lower();
    }

    function canWorkProject(projectId) {
      return projectId is string &&
          projectId != '' &&
          (
            hasProjectAccess(projectId) ||
            isProjectSiteManager(projectId) ||
            emailMatchesProjectEngineer(projectId)
          );
    }

    // Budgets collection - CEO Head and Admin only
    match /budgets/{budgetId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isCeoHead()
      );
      allow create, update, delete: if request.auth != null && (
        isAdmin() ||
        isCeoHead()
      );
    }
    
    // TEMP: allow all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
